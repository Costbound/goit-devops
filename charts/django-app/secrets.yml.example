# Copy this file to secrets.yml and fill in real values.
# secrets.yml is gitignored and must be created locally by each developer.
#
# Usage:
#   helm install django-app ./charts/django-app \
#     -f charts/django-app/values.yml \
#     -f charts/django-app/secrets.yml

image:
  repository: YOUR_ACCOUNT_ID.dkr.ecr.us-east-1.amazonaws.com/lesson-7-ecr

config:
  POSTGRES_USER: your_db_user
  POSTGRES_PASSWORD: your_db_password
